# ─────────────────────────────────────────────────────────────
#  Template environment — SALIN ke ops/.env lalu isi nilainya.
#  JANGAN pernah commit ops/.env (sudah masuk .gitignore).
# ─────────────────────────────────────────────────────────────

# ── PocketBase (embedded di backend Go) ──────────────────────
# Folder penyimpanan SQLite + file storage
PB_DATA_DIR=./pb_data
# Superuser pertama untuk Admin UI (https://domain-anda.com/_/)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=ganti-dengan-password-kuat-minimal-10-karakter

# ── Google OAuth (didaftarkan di Google Cloud Console) ────────
# Authorized redirect URI: https://domain-anda.com/api/oauth2-redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gemini AI (endpoint /api/v1/ai/insights) ──────────────────
GEMINI_API_KEY=

# ── Server ───────────────────────────────────────────────────
# Port listener PocketBase (REST + Realtime + Admin)
PB_PORT=8080
# Port listener Go Fiber (reports, export, ai, auth/unlock)
API_PORT=8081
# Environment: development | production
APP_ENV=development
# Origins yang diizinkan oleh CORS (pisahkan koma, tanpa spasi)
CORS_ORIGINS=http://localhost:3000,http://localhost:4321,http://192.168.100.9:3000,capacitor://localhost,capacitor://ios

# ── Rate limit (request per menit per IP, untuk endpoint Go) ───
RATE_LIMIT_PER_MIN=120

# ── Domain produksi (untuk Caddy + OAuth) ─────────────────────
SITE_DOMAIN=example.com