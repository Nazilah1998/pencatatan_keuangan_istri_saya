{
  "name": "sintya-finance",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sintya/frontend dev",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "pnpm --filter @sintya/frontend build",
    "build:api": "cd backend && go build -trimpath -ldflags=\"-s -w\" -o bin/server ./cmd/server",
    "lint": "pnpm --filter @sintya/frontend lint",
    "typecheck": "pnpm --filter @sintya/frontend typecheck",
    "test": "cd backend && go test ./...",
    "check": "pnpm --filter @sintya/frontend check",
    "cap:sync": "pnpm --filter @sintya/frontend cap:sync"
  }
}