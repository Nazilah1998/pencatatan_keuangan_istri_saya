---
/**
 * Layout untuk halaman autentikasi: satu kolom, tanpa sidebar.
 */
import BaseLayout from './BaseLayout.astro'

import { ThemeToggle } from '../components/ui/ThemeToggle'

type Props = {
  title: string
  description?: string
}

const { title, description } = Astro.props
---

<BaseLayout title={title} description={description}>
  <main class="safe-top mx-auto flex min-h-dvh w-full max-w-md flex-col px-5 py-6">
    <header class="flex items-center justify-between">
      <span class="flex items-center gap-2.5">
        <span
          class="grid size-9 place-items-center rounded-[0.625rem] bg-[var(--accent-soft)] font-display text-base font-bold text-[var(--accent)]"
        >
          S
        </span>
        <span class="font-display text-base font-semibold">Sintya Finance</span>
      </span>
      <ThemeToggle client:idle />
    </header>

    <div class="flex flex-1 items-center py-10">
      <slot />
    </div>
  </main>
</BaseLayout>