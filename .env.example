# ==========================================
# Sintya Finance - Environment Configuration
# ==========================================
# File ini adalah template. Di lingkungan produksi/pengembangan,
# nilai-nilai ini diinjeksi secara terpusat melalui Infisical Cloud (/Sintya-Finance).

# --- App & Server Environment ---
APP_ENV=development
PORT=3000
PB_PORT=8080
API_PORT=8081
PB_DATA_DIR=./pb_data
SITE_DOMAIN=sintya.nazilah.id

# --- Public Frontend Config ---
PUBLIC_PB_URL=https://db-sintya.nazilah.id
REMOTE_PB_URL=https://db-sintya.nazilah.id
PUBLIC_API_BASE=https://db-sintya.nazilah.id/api/v1
PUBLIC_APP_NAME="Sintya Finance"
PUBLIC_DEFAULT_LANG=id

# --- PocketBase Superuser Credentials ---
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change_this_password

# --- Security & CORS ---
CORS_ORIGINS=https://sintya.nazilah.id,https://db-sintya.nazilah.id,capacitor://localhost,capacitor://ios,http://localhost:3000
RATE_LIMIT_PER_MIN=120

# --- Third-party Integrations ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GEMINI_API_KEY=your-gemini-api-key

# --- Infisical Universal Auth (Opsional untuk sync lokal) ---
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=4dc09f19-337c-473f-9797-a8893fc11254
# INFISICAL_ENV=dev
# INFISICAL_SECRET_PATH=/Sintya-Finance
