:{$PORT:8080} {
    root * /usr/share/caddy
    encode gzip zstd

    # Health check endpoint for Coolify / Docker
    handle /health {
        respond "OK" 200
    }

    # Dynamic environment config - never cache
    @envConfig path /env-config.js
    header @envConfig Cache-Control "no-store, no-cache, must-revalidate"

    # Static assets cache
    @assets path /_astro/* /assets/* /fonts/* /icons/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # SPA routing fallback for Astro static directory
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}
